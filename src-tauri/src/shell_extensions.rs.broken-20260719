            command: r"C:\test.exe %1".into(),
            delegate_execute: None,
            position: Some("Top".into()),
            is_extended: false,
            has_lua_shield: false,
            source_key: r"HKCR\*\shell\TestEntry".into(),
        };
        let json = serde_json::to_string(&entry).unwrap();
        let back: ShellEntry = serde_json::from_str(&json).unwrap();
        assert_eq!(back.label, entry.label);
