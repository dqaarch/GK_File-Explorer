// Phase 1: enumerate Windows shell extensions registered for file/folder/background
// context menus. Reads HKCU + HKCR (which mirrors HKLM\Software\Classes) to gather
// the same entries Windows Explorer shows in "Show more options".
//
// Strategy:
//   1. For each scope (Files, Directory, Background, Drive, Desktop, AllFileSystem):
//      enumerate subkeys of `shell\`.
//   2. For each subkey, parse `(default)`, `MUIVerb`, `Icon`, `Position`, `Extended`
//      from the key itself.
//   3. Read `command\(default)` for the executable/command line.
//   4. Return Vec<ShellEntry> as JSON for the frontend.
//
// All registry reads are read-only — no HKLM admin needed.

use serde::{Deserialize, Serialize};

#[cfg(windows)]
use windows::Win32::System::Registry::{
    RegOpenKeyExW, RegQueryValueExW, RegCloseKey, RegEnumKeyExW,
    HKEY, KEY_READ, REG_VALUE_TYPE,
};
#[cfg(windows)]
use windows::Win32::Foundation::ERROR_SUCCESS;

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq, Hash)]
#[serde(rename_all = "snake_case")]
pub enum ShellScope {
    /// All files (*\shell) — right-click on any file
    Files,
    /// File folders (Directory\shell) — right-click on a folder
    Directory,
    /// Folder background (Directory\Background\shell) — right-click empty space
    Background,
    /// Drives (Drive\shell) — right-click on D:\ etc.
    Drive,
    /// Desktop background (DesktopBackground\Shell) — right-click on desktop
    Desktop,
    /// Files + folders (AllFilesystemObjects\shell)
    AllFileSystem,
}

impl ShellScope {
    /// HKCU root path for this scope.
    fn hkcu_path(&self) -> &'static str {
        match self {
            Self::Files => r"Software\Classes\*\shellex\ContextMenuHandlers",
            Self::Directory => r"Software\Classes\Directory\shellex\ContextMenuHandlers",
            Self::Background => r"Software\Classes\Directory\Background\shellex\ContextMenuHandlers",
            Self::Drive => r"Software\Classes\Drive\shellex\ContextMenuHandlers",
            Self::Desktop => r"Software\Classes\DesktopBackground\shellex\ContextMenuHandlers",
            Self::AllFileSystem => r"Software\Classes\AllFilesystemObjects\shellex\ContextMenuHandlers",
        }
    }

    /// HKLM root path for this scope.
    fn hklm_path(&self) -> &'static str {
        match self {
            Self::Files => r"SOFTWARE\Classes\*\shellex\ContextMenuHandlers",
            Self::Directory => r"SOFTWARE\Classes\Directory\shellex\ContextMenuHandlers",
            Self::Background => r"SOFTWARE\Classes\Directory\Background\shellex\ContextMenuHandlers",
            Self::Drive => r"SOFTWARE\Classes\Drive\shellex\ContextMenuHandlers",
            Self::Desktop => r"SOFTWARE\Classes\DesktopBackground\shellex\ContextMenuHandlers",
            Self::AllFileSystem => r"SOFTWARE\Classes\AllFilesystemObjects\shellex\ContextMenuHandlers",
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ShellEntry {
    pub id: String,
    pub scope: ShellScope,
    pub name: String,
    pub label: String,
    pub accelerator: Option<char>,
    pub icon: Option<String>,
    pub command: String,
    pub delegate_execute: Option<String>,
    pub position: Option<String>,
    pub is_extended: bool,
    pub has_lua_shield: bool,
    pub source_key: String,
}

#[derive(Debug, Clone, Serialize, Deserialize, Default)]
pub struct ShellEntriesResponse {
    pub files: Vec<ShellEntry>,
    pub directory: Vec<ShellEntry>,
    pub background: Vec<ShellEntry>,
    pub drive: Vec<ShellEntry>,
    pub desktop: Vec<ShellEntry>,
    pub all_file_system: Vec<ShellEntry>,
}

const HKEY_CURRENT_USER: isize = 0x80000001_u32 as isize;
const HKEY_LOCAL_MACHINE: isize = 0x80000002_u32 as isize;

// On Windows, an isize can be reinterpreted as a `*mut c_void` to form a
// `HKEY` for predefined root keys. Wrap that once so call-sites stay safe.
#[inline]
fn predefined_hkey(value: isize) -> HKEY {
    HKEY(value as *mut _)
}

// ── Tauri command ────────────────────────────────────────────────────────

/// Enumerate shell extensions across all relevant scopes.
///
/// `target_extension` is optional — when supplied the result also includes
/// `target_extension` entries from `SystemFileAssociations` (per-extension).
/// Phase 2 will use this for icon resolution; Phase 6 will use it for the
/// frontend `useShellExtensions` hook.
#[tauri::command]
pub fn list_shell_extensions(target_extension: Option<String>) -> ShellEntriesResponse {
    #[cfg(windows)]
    {
        let mut out = ShellEntriesResponse::default();
        for scope in [
            ShellScope::Files,
            ShellScope::Directory,
            ShellScope::Background,
            ShellScope::Drive,
            ShellScope::Desktop,
            ShellScope::AllFileSystem,
        ] {
            // Try HKCU first, then HKLM. Merge results (HKCU wins on duplicates).
            let mut entries: Vec<ShellEntry> = Vec::new();
            let mut seen_ids: std::collections::HashSet<String> =
                std::collections::HashSet::new();

            for &root in &[
                (HKEY_CURRENT_USER, scope.hkcu_path()),
            ] {
                for e in read_scope(root.0, root.1, scope.clone()) {
                    if seen_ids.insert(e.id.clone()) {
                        entries.push(e);
                    }
                }
            }

            for e in read_scope(HKEY_LOCAL_MACHINE, scope.hklm_path(), scope.clone()) {
                if seen_ids.insert(e.id.clone()) {
                    entries.push(e);
                }
            }

            sort_entries(&mut entries);

            match scope {
                ShellScope::Files => out.files = entries,
                ShellScope::Directory => out.directory = entries,
                ShellScope::Background => out.background = entries,
                ShellScope::Drive => out.drive = entries,
                ShellScope::Desktop => out.desktop = entries,
                ShellScope::AllFileSystem => out.all_file_system = entries,
            }
        }

        // Per-extension SystemFileAssociations (Phase 2 / 6 will use this).
        if let Some(ext) = target_extension {
            if !ext.is_empty() {
                let ext_clean = ext.trim_start_matches('.').to_lowercase();
                let hklm_path = format!(
                    r"SOFTWARE\Classes\SystemFileAssociations\.{}\shell",
                    ext_clean
                );
                let hkcu_path = format!(
                    r"Software\Classes\SystemFileAssociations\.{}\shell",
                    ext_clean
                );
                let mut ext_entries: Vec<ShellEntry> = Vec::new();
                let mut seen: std::collections::HashSet<String> =
                    std::collections::HashSet::new();

                for root_path in [hkcu_path.as_str(), hklm_path.as_str()] {
                    for e in read_scope(
                        HKEY_CURRENT_USER,
                        root_path,
                        ShellScope::Files,
                    ) {
                        if seen.insert(e.id.clone()) {
                            ext_entries.push(e);
                        }
                    }
                }
                out.files.extend(ext_entries);
            }
        }

        out
    }

    #[cfg(not(windows))]
    {
        let _ = target_extension;
        ShellEntriesResponse::default()
    }
}

// ── Helpers ──────────────────────────────────────────────────────────────

#[cfg(windows)]
fn read_scope(root: isize, path: &str, scope: ShellScope) -> Vec<ShellEntry> {
    let mut entries = Vec::new();

    let hkey = unsafe {
        let mut hkey: HKEY = HKEY(std::ptr::null_mut());
        let root_handle = predefined_hkey(root);
        let path_w: Vec<u16> = path.encode_utf16().chain(std::iter::once(0)).collect();

        let result = RegOpenKeyExW(
            root_handle,
            windows::core::PCWSTR(path_w.as_ptr()),
            0,
            KEY_READ,
            &mut hkey,
        );

        if result != ERROR_SUCCESS {
            eprintln!("[shell_extensions] RegOpenKeyExW failed for root=0x{:x} path={} err={}", root, path, result.0);
            return entries;
        }
        eprintln!("[shell_extensions] Opened root=0x{:x} path={} OK", root, path);
        hkey
    };

    // Enumerate subkeys: names at most 256 chars, index 0..n until ERROR_NO_MORE_ITEMS (259).
    for index in 0..512u32 {
        let mut name_buf = [0u16; 256];
        let mut name_len = name_buf.len() as u32;
        let result = unsafe {
            RegEnumKeyExW(
                hkey,
                index,
                windows::core::PWSTR(name_buf.as_mut_ptr()),
                &mut name_len,
                None,
                windows::core::PWSTR(std::ptr::null_mut()),
                None,
                None,
            )
        };
        if result != ERROR_SUCCESS {
            eprintln!("[shell_extensions] RegEnumKeyExW break at index={} err={}", index, result.0);
            break;
        }
        let name = String::from_utf16_lossy(&name_buf[..name_len as usize]);
        let subkey_full = format!(r"{}\{}", path, name);
        eprintln!("[shell_extensions] subkey found: {} (full={})", name, subkey_full);

        // Read the entry's own values.
        let entry_hkey = unsafe {
            let mut sub_hkey: HKEY = HKEY(std::ptr::null_mut());
            let full_w: Vec<u16> = subkey_full.encode_utf16().chain(std::iter::once(0)).collect();
            let result = RegOpenKeyExW(
                hkey,
                windows::core::PCWSTR(full_w.as_ptr()),
                0,
                KEY_READ,
                &mut sub_hkey,
            );
            if result != ERROR_SUCCESS {
                None
            } else {
                Some(sub_hkey)
            }
        };

        let (default_value, label) = if let Some(sub_hkey) = entry_hkey {
            let default = read_string_value(sub_hkey, "");
            let muiverb = read_string_value(sub_hkey, "MUIVerb");
            let label_text = muiverb
                .or(default.clone())
                .unwrap_or_else(|| name.clone());
            (default, label_text)
        } else {
            (None, name.clone())
        };

        let (accel, label_clean) = parse_accelerator(&label);
        let icon = if let Some(sub_hkey) = entry_hkey {
            read_string_value(sub_hkey, "Icon")
        } else {
            None
        };
        let position = if let Some(sub_hkey) = entry_hkey {
            read_string_value(sub_hkey, "Position")
        } else {
            None
        };
        let is_extended = if let Some(sub_hkey) = entry_hkey {
            value_exists(sub_hkey, "Extended")
        } else {
            false
        };
        let has_lua_shield = if let Some(sub_hkey) = entry_hkey {
            value_exists(sub_hkey, "HasLUAShield")
        } else {
            false
        };
        let delegate_execute = if let Some(sub_hkey) = entry_hkey {
            read_string_value(sub_hkey, "DelegateExecute")
        } else {
            None
        };

        // Read the `command\(default)` for the actual command line.
        let command = if let Some(sub_hkey) = entry_hkey {
            let cmd_path = format!(r"{}\command", subkey_full);
            let cmd_hkey = unsafe {
                let mut cmd_hkey: HKEY = HKEY(std::ptr::null_mut());
                let cmd_w: Vec<u16> = cmd_path.encode_utf16().chain(std::iter::once(0)).collect();
                let result = RegOpenKeyExW(
                    hkey,
                    windows::core::PCWSTR(cmd_w.as_ptr()),
                    0,
                    KEY_READ,
                    &mut cmd_hkey,
                );
                if result != ERROR_SUCCESS {
                    None
                } else {
                    Some(cmd_hkey)
                }
            };
            let cmd_str = cmd_hkey
                .and_then(|hk| read_string_value(hk, ""))
                .unwrap_or_default();
            if let Some(cmd_hkey) = cmd_hkey {
                unsafe { let _ = RegCloseKey(cmd_hkey); }
            }
            cmd_str
        } else {
            String::new()
        };

        if let Some(sub_hkey) = entry_hkey {
            unsafe { let _ = RegCloseKey(sub_hkey); }
        }

        // Subkeys under `shellex\ContextMenuHandlers` carry a CLSID GUID as
        // their `(default)` value rather than a `command\(default)` line.
        // Capture that GUID so the execute path can route through COM.
        let clsid_guid = match &default_value {
            Some(v) if v.starts_with('{') && v.ends_with('}') => Some(v.clone()),
            _ => None,
        };
        let delegate_execute_final: Option<String> =
            delegate_execute.clone().or(clsid_guid.clone());

        if command.is_empty()
            && delegate_execute_final.is_none()
            && label.is_empty()
            && clsid_guid.is_none()
        {
            // Skip truly empty entries (rare / malformed). Microsoft built-in
            // verbs like "Display" / "Personalize" don't write a command but
            // do carry a (default) label, so they're kept above this guard.
            continue;
        }

        let id = format!("{}::{}::{}", scope_label(&scope), path, name);

        entries.push(ShellEntry {
            id,
            scope: scope.clone(),
            name: name.clone(),
            label: label_clean,
            accelerator: accel,
            icon,
            command,
            delegate_execute: delegate_execute_final,
            position,
            is_extended,
            has_lua_shield,
            source_key: subkey_full,
        });
    }

    unsafe { let _ = RegCloseKey(hkey); }

    entries
}

#[cfg(windows)]
fn read_string_value(hkey: HKEY, value_name: &str) -> Option<String> {
    unsafe {
        let name_w: Vec<u16> = if value_name.is_empty() {
            Vec::new()
        } else {
            value_name.encode_utf16().chain(std::iter::once(0)).collect()
        };
        let name_pcwstr = if value_name.is_empty() {
            windows::core::PCWSTR(std::ptr::null())
        } else {
            windows::core::PCWSTR(name_w.as_ptr())
        };

        // First call: query size.
        let mut data_type = REG_VALUE_TYPE(0);
        let mut data_size: u32 = 0;
        let query_result = RegQueryValueExW(
            hkey,
            name_pcwstr,
            None,
            Some(&mut data_type),
            None,
            Some(&mut data_size),
        );
        if query_result != ERROR_SUCCESS || data_size == 0 {
            return None;
        }

        // Second call: read data.
        let mut buffer = vec![0u8; data_size as usize];
        let read_result = RegQueryValueExW(
            hkey,
            name_pcwstr,
            None,
            Some(&mut data_type),
            Some(buffer.as_mut_ptr()),
            Some(&mut data_size),
        );
        if read_result != ERROR_SUCCESS {
            return None;
        }

        // REG_SZ = 1, REG_EXPAND_SZ = 2. Match against REG_VALUE_TYPE.
        let dt = data_type.0;
        if dt == 1 || dt == 2 {
            // bytes are u16; ensure even.
            let usable_len = data_size as usize & !1;
            let wide: Vec<u16> = buffer[..usable_len]
                .chunks_exact(2)
                .map(|c| u16::from_le_bytes([c[0], c[1]]))
                .collect();
            // Strip trailing nulls.
            let trimmed: Vec<u16> = wide.into_iter().take_while(|&c| c != 0).collect();
            Some(String::from_utf16_lossy(&trimmed))
        } else {
            // Other types (REG_BINARY, etc.) — return hex representation.
            Some(format!("<binary {} bytes>", data_size))
        }
    }
}

#[cfg(windows)]
fn value_exists(hkey: HKEY, value_name: &str) -> bool {
    unsafe {
        let name_w: Vec<u16> = value_name.encode_utf16().chain(std::iter::once(0)).collect();
        let name_pcwstr = windows::core::PCWSTR(name_w.as_ptr());

        let mut data_type = REG_VALUE_TYPE(0);
        let mut data_size: u32 = 0;
        let result = RegQueryValueExW(
            hkey,
            name_pcwstr,
            None,
            Some(&mut data_type),
            None,
            Some(&mut data_size),
        );
        result == ERROR_SUCCESS
    }
}

/// Phase 1.10 — Windows Explorer ordering for context-menu verbs.
///
/// Mirrors what `IShellFolder::GetUIObjectOf` does internally:
///   1. Honour the `Position` registry value: `"Top"` items first, `"Bottom"`
///      items last, `"Middle"` slots in normal order.
///   2. Within each band, sort case-insensitive by visible label.
///   3. Stripped of accelerator underscores (`&`) for fair comparison.
fn sort_entries(entries: &mut Vec<ShellEntry>) {
    fn band(p: Option<&String>) -> u8 {
        match p.map(|s| s.trim().to_ascii_lowercase()).as_deref() {
            Some("top") => 0,
            Some("middle") | None => 1,
            Some("bottom") => 2,
            _ => 1, // unknown position values (`"first"`, etc.) → middle
        }
    }

    fn strip_amp(s: &str) -> String {
        s.chars()
            .enumerate()
            .filter(|(i, c)| !(*c == '&' && *i + 1 < s.chars().count()))
            .map(|(_, c)| c)
            .collect()
    }

    entries.sort_by(|a, b| {
        let ba = band(a.position.as_ref());
        let bb = band(b.position.as_ref());
        if ba != bb {
            return ba.cmp(&bb);
        }
        let la = strip_amp(&a.label).to_lowercase();
        let lb = strip_amp(&b.label).to_lowercase();
        la.cmp(&lb)
    });
}

// ── Phase 1.9: execute shell extension ────────────────────────────────────

#[cfg(windows)]
use windows::Win32::UI::Shell::{ShellExecuteExW, SEE_MASK_NOASYNC, SHELLEXECUTEINFOW};
#[cfg(windows)]
use windows::Win32::Foundation::HWND;

/// Result returned to the frontend after invoking a shell verb.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ShellExecuteResult {
    pub ok: bool,
    /// Win32 error code returned by ShellExecuteExW (0 on success).
    pub error_code: i32,
    /// Human-readable status (e.g. "success", "no app associated", "not found").
    pub message: String,
    /// The executed command (after `%1` / `%V` substitution).
    pub resolved_command: String,
}

/// Maximum command line length we'll accept. Realistic upper bound for an
/// interactive verb — anything beyond this is almost certainly malformed.
const MAX_CMD_LINE: usize = 4096;

/// Splits a command string into (executable, arguments) honoring double-quoted
/// paths. Returns `None` if parsing fails (unterminated quotes, empty, etc.).
///
/// Examples:
///   `C:\\Windows\\System32\\notepad.exe "%1"` → ("notepad.exe", [`C:\…\notepad.exe`, `"%1"`])
///   `"C:\\Program Files\\Git\\git-bash.exe" --cd="%V"` → (…args split correctly)
fn split_command(cmd: &str) -> Option<(String, Vec<String>)> {
    let trimmed = cmd.trim();
    if trimmed.is_empty() {
        return None;
    }
    let mut args: Vec<String> = Vec::new();
    let mut current = String::new();
    let mut in_quotes = false;
    let mut chars = trimmed.chars().peekable();
    while let Some(c) = chars.next() {
        match c {
            '"' => {
                in_quotes = !in_quotes;
                current.push(c);
            }
            c if c.is_whitespace() && !in_quotes => {
                if !current.is_empty() {
                    args.push(std::mem::take(&mut current));
                }
            }
            c => current.push(c),
        }
    }
    if in_quotes {
        return None; // unterminated quote
    }
    if !current.is_empty() {
        args.push(current);
    }
    let exe = args.first()?.clone();
    Some((exe, args))
}

/// Replace common verb substitution tokens with the target path.
///
/// `%1` (or `%L`) — single file path.
/// `%V`           — parent directory (used by VS Code / PowerShell here).
/// `%W`           — working directory (legacy; we treat as parent dir).
/// `%D`           — desktop path (rarely used in verbs).
fn expand_placeholders(cmd: &str, target: &str) -> String {
    let parent = std::path::Path::new(target)
        .parent()
        .map(|p| p.to_string_lossy().to_string())
        .unwrap_or_default();
    cmd.replace("%1", target)
        .replace("%L", target)
        .replace("%V", &parent)
        .replace("%W", &parent)
        .replace("%D", target)
}

/// Sanity-check that the target path exists and is on disk. We refuse to run a
/// verb against a fabricated path since that could fire `ShellExecuteExW` with
/// any string the frontend sent.
fn validate_target(target: &str) -> Result<(), String> {
    if target.is_empty() {
        return Err("empty target path".into());
    }
    if target.len() > 1024 {
        return Err("target path too long".into());
    }
    let p = std::path::Path::new(target);
    if !p.exists() {
        return Err(format!("target does not exist: {}", target));
    }
    Ok(())
}

/// Phase 1.9 — invoke a shell verb (e.g. "Open in VS Code") for the given path.
///
/// Args:
///   * `entry_id`  — `ShellEntry::id` produced by `list_shell_extensions`.
///   * `target`    — full path to the file/folder the verb should operate on.
///
/// Steps:
///   1. Re-run `list_shell_extensions` to find the entry by id (avoids trusting
///      a path or command string from the frontend).
///   2. Substitute `%1` / `%V` / … with the target path and parent dir.
///   3. Tokenize the command line, escape with ShellExecuteExW semantics.
///   4. Call `ShellExecuteExW` with `SEE_MASK_NOASYNC` (we don't want a thread
///      join — fire-and-forget UI launch).
#[tauri::command]
pub fn execute_shell_extension(entry_id: String, target: String) -> ShellExecuteResult {
    #[cfg(windows)]
    {
        if let Err(msg) = validate_target(&target) {
            return ShellExecuteResult {
                ok: false,
                error_code: -1,
                message: msg,
                resolved_command: String::new(),
            };
        }

        // Re-enumerate to find the entry. This means a malicious or stale
        // `entry_id` from the renderer cannot redirect to an arbitrary verb.
        let resp = list_shell_extensions(None);
        let all_entries: Vec<&ShellEntry> = resp
            .files
            .iter()
            .chain(resp.directory.iter())
            .chain(resp.background.iter())
            .chain(resp.drive.iter())
            .chain(resp.desktop.iter())
            .chain(resp.all_file_system.iter())
            .collect();

        let entry = match all_entries.into_iter().find(|e| e.id == entry_id) {
            Some(e) => e,
            None => {
                return ShellExecuteResult {
                    ok: false,
                    error_code: -2,
                    message: format!("entry not found: {}", entry_id),
                    resolved_command: String::new(),
                };
            }
        };

        // Substitute placeholders. If the verb didn't define a command line,
        // it's likely a `DelegateExecute`/COM verb we can't drive from
        // ShellExecuteExW directly — we return a friendly hint.
        let resolved = expand_placeholders(&entry.command, &target);
        if resolved.is_empty() {
            return ShellExecuteResult {
                ok: false,
                error_code: 0,
                message: format!(
                    "'{}' uses a COM delegate handler and can't be launched via command line",
                    entry.label
                ),
                resolved_command: String::new(),
            };
        }
        if resolved.len() > MAX_CMD_LINE {
            return ShellExecuteResult {
                ok: false,
                error_code: -3,
                message: format!("command line too long ({} bytes)", resolved.len()),
                resolved_command: resolved,
            };
        }

        // Tokenize: ShellExecuteExW expects (lpVerb, lpFile, lpParameters, …).
        // We split into the executable and "everything else as one parameter
        // blob" since ShellExecuteExW handles command-line quoting internally.
        let (exe, rest_args) = match split_command(&resolved) {
            Some(pair) => pair,
            None => {
                return ShellExecuteResult {
                    ok: false,
                    error_code: -4,
                    message: "could not parse command line (unterminated quote?)".into(),
                    resolved_command: resolved,
                };
            }
        };
        // Re-stitch everything after the executable as one parameters blob so
        // the shell sees it as the caller's full argv[1..].
        let params_blob = rest_args
            .iter()
            .skip(1)
            .cloned()
            .collect::<Vec<_>>()
            .join(" ");

        let verb_w: Vec<u16> = wide_null("");
        let exe_w: Vec<u16> = wide_null(&exe);
        let params_w: Vec<u16> = wide_null(&params_blob);
        let dir_w: Vec<u16> = wide_null(
            std::path::Path::new(&target)
                .parent()
                .map(|p| p.to_string_lossy().to_string())
                .unwrap_or_default()
                .as_str(),
        );

        eprintln!(
            "[shell_extensions] exec id={} exe='{}' params='{}'",
            entry_id, exe, params_blob
        );

        let mut info = SHELLEXECUTEINFOW {
            cbSize: std::mem::size_of::<SHELLEXECUTEINFOW>() as u32,
            fMask: SEE_MASK_NOASYNC,
            hwnd: HWND(std::ptr::null_mut()),
            lpVerb: windows::core::PCWSTR(verb_w.as_ptr()),
            lpFile: windows::core::PCWSTR(exe_w.as_ptr()),
            lpParameters: windows::core::PCWSTR(params_w.as_ptr()),
            lpDirectory: windows::core::PCWSTR(dir_w.as_ptr()),
            nShow: 1, // SW_SHOWNORMAL
            ..Default::default()
        };

        let result = unsafe { ShellExecuteExW(&mut info) };
        // ShellExecuteExW returns `Result<()>`. Success means the shell queued
        // the launch; the launched process itself runs out-of-process.
        let ok = result.is_ok();
        let msg = if ok {
            "launched".to_string()
        } else {
            // We don't get a Win32 error code from Result<()> in windows-rs.
            // Report the COM-style error message and a sentinel code of -1.
            result
                .err()
                .map(|e| format!("ShellExecuteExW failed: {}", e))
                .unwrap_or_else(|| "ShellExecuteExW failed".into())
        };
        let code = if ok { 33 } else { -1 }; // 33 == >32 = success threshold

        ShellExecuteResult {
            ok,
            error_code: code,
            message: msg,
            resolved_command: format!("{}\0", resolved),
        }
    }
    #[cfg(not(windows))]
    {
        let _ = (entry_id, target);
        ShellExecuteResult {
            ok: false,
            error_code: -1,
            message: "shell extensions are Windows-only in this build".into(),
            resolved_command: String::new(),
        }
    }
}

#[cfg(windows)]
fn wide_null(s: &str) -> Vec<u16> {
    s.encode_utf16().chain(std::iter::once(0)).collect()
}

/// Parses `Sc&an` → `(Some('a'), "Scan")`, `Scan` → `(None, "Scan")`.
fn parse_accelerator(label: &str) -> (Option<char>, String) {
    if let Some(idx) = label.find('&') {
        let after = &label[idx + 1..];
        if let Some(c) = after.chars().next() {
            let mut clean = String::with_capacity(label.len());
            clean.push_str(&label[..idx]);
            clean.push_str(&label[idx + 1..]);
            return (Some(c), clean);
        }
    }
    (None, label.to_string())
}

fn scope_label(scope: &ShellScope) -> &'static str {
    match scope {
        ShellScope::Files => "files",
        ShellScope::Directory => "directory",
        ShellScope::Background => "background",
        ShellScope::Drive => "drive",
        ShellScope::Desktop => "desktop",
        ShellScope::AllFileSystem => "all_file_system",
    }
}

