{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goku File Explorer",
  "version": "1.0.3",
  "identifier": "com.goku.fileexplorer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goku File Explorer V.1.0.3 Beta",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:18765 http://127.0.0.1:18765 http://asset.localhost https://asset.localhost http://ipc.localhost ipc: asset: https://asset.localhost blob: data:; img-src 'self' asset: https://asset.localhost blob: data: http://localhost:18765 http://127.0.0.1:18765 http://ipc.localhost; media-src 'self' asset: https://asset.localhost blob: data: file: http://localhost:18765 http://127.0.0.1:18765 http://ipc.localhost http://asset.localhost; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle_dist/ffmpeg": "ffmpeg/",
      "../bundle_dist/poppler": "poppler/",
      "../bundle_dist/openexr": "openexr/",
      "../bundle_dist/python": "python/",
      "../bundle_dist/luts/Linear_sRGB.bin": "luts/Linear_sRGB.bin",
      "../bundle_dist/luts/Raw.bin": "luts/Raw.bin",
      "../bundle_dist/luts/ACES_1_3_CG__sRGB_Display__ACES_1_0_SDR_Video.bin": "luts/ACES_1_3_CG__sRGB_Display__ACES_1_0_SDR_Video.bin",
      "../bundle_dist/luts/ACES_1_3_CG__sRGB_Display__Un_tone_mapped.bin": "luts/ACES_1_3_CG__sRGB_Display__Un_tone_mapped.bin",
      "../bundle_dist/luts/ACES_1_3_CG__sRGB_Display__Raw.bin": "luts/ACES_1_3_CG__sRGB_Display__Raw.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__ACES_1_0_SDR_Video.bin": "luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__ACES_1_0_SDR_Video.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__Un_tone_mapped.bin": "luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__Un_tone_mapped.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__Raw.bin": "luts/ACES_1_3_CG__Rec_1886_Rec_709_Display__Raw.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_2100_PQ_Display__ACES_1_1_HDR_Video_1000_nits_Rec_2020_lim.bin": "luts/ACES_1_3_CG__Rec_2100_PQ_Display__ACES_1_1_HDR_Video_1000_nits_Rec_2020_lim.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_2100_PQ_Display__Un_tone_mapped.bin": "luts/ACES_1_3_CG__Rec_2100_PQ_Display__Un_tone_mapped.bin",
      "../bundle_dist/luts/ACES_1_3_CG__Rec_2100_PQ_Display__Raw.bin": "luts/ACES_1_3_CG__Rec_2100_PQ_Display__Raw.bin",
      "../bundle_dist/luts/ACES_1_3_CG__ST2084_P3_D65_Display__ACES_1_1_HDR_Video_1000_nits_P3_lim.bin": "luts/ACES_1_3_CG__ST2084_P3_D65_Display__ACES_1_1_HDR_Video_1000_nits_P3_lim.bin",
      "../bundle_dist/luts/ACES_1_3_CG__ST2084_P3_D65_Display__Un_tone_mapped.bin": "luts/ACES_1_3_CG__ST2084_P3_D65_Display__Un_tone_mapped.bin",
      "../bundle_dist/luts/ACES_1_3_CG__ST2084_P3_D65_Display__Raw.bin": "luts/ACES_1_3_CG__ST2084_P3_D65_Display__Raw.bin",
      "../bundle_dist/luts/ACES_1_3_CG__P3_D65_Display__ACES_1_0_SDR_Cinema.bin": "luts/ACES_1_3_CG__P3_D65_Display__ACES_1_0_SDR_Cinema.bin",
      "../bundle_dist/luts/ACES_1_3_CG__P3_D65_Display__Un_tone_mapped.bin": "luts/ACES_1_3_CG__P3_D65_Display__Un_tone_mapped.bin",
      "../bundle_dist/luts/ACES_1_3_CG__P3_D65_Display__Raw.bin": "luts/ACES_1_3_CG__P3_D65_Display__Raw.bin",
      "Tools/bake_ocio_lut.py": "Tools/bake_ocio_lut.py",
      "scripts/ewa_export_sequence.py": "Tools/ewa_export_sequence.py",
      "python/skp_parser.py": "Tools/skp_parser.py",
      "../dist/usd-bindings/emHdBindings.js": "usd-bindings/emHdBindings.js",
      "../dist/usd-bindings/emHdBindings.wasm": "usd-bindings/emHdBindings.wasm"
    },
    "publisher": "Dqa/GokuMedia",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["English", "Vietnamese"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {}
}
