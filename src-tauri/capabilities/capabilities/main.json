{
  "$schema": "https://schemas.tauri.app/config/2/capability.json",
  "identifier": "main-capability",
  "description": "Main capability for GK File Explorer",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:event:allow-listen",
    "core:event:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read",
    "fs:allow-write",
    "fs:read-all",
    "fs:write-all",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": true },
        { "name": "wt", "cmd": "wt.exe", "args": true },
        { "name": "python", "cmd": "python", "args": true },
        { "name": "python3", "cmd": "python3", "args": true },
        { "name": "py", "cmd": "py", "args": true },
        { "name": "python_exe", "cmd": "python.exe", "args": true },
        { "name": "python3_exe", "cmd": "python3.exe", "args": true },
        { "name": "py_exe", "cmd": "py.exe", "args": true },
        { "name": "where", "cmd": "where", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "cmd", "cmd": "cmd", "args": true },
        { "name": "wt", "cmd": "wt.exe", "args": true },
        { "name": "python", "cmd": "python", "args": true },
        { "name": "python3", "cmd": "python3", "args": true },
        { "name": "py", "cmd": "py", "args": true },
        { "name": "python_exe", "cmd": "python.exe", "args": true },
        { "name": "python3_exe", "cmd": "python3.exe", "args": true },
        { "name": "py_exe", "cmd": "py.exe", "args": true }
      ]
    },
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:default",
    "drag:default"
  ]
}
